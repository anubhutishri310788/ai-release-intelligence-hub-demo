# MCP Environment Variables
#
# IMPORTANT: Never commit the actual .env file with real credentials to git!
# Use .env.example as a template and create .env locally with real values.
# Add .env to .gitignore

# GitHub MCP Server
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# Atlassian MCP Server (Jira/Confluence)
ATLASSIAN_HOST=your-workspace.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=ATATT_your_atlassian_token_here
